{
  "name": "howtogit",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive, visual git tutorial for beginners: howtogit.dev",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "dev": "tsc && wrangler dev",
    "start": "tsc && wrangler dev",
    "deploy": "tsc && wrangler deploy",
    "check": "tsc && node scripts/check-story.mjs && node scripts/check-design.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:ui": "node scripts/check-selection.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "wrangler": "^4"
  }
}
